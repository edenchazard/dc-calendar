{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "ts:check": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@types/luxon": "^3.4.2",
    "@vueuse/core": "^14.2.1",
    "astronomia": "^4.1.1",
    "floating-vue": "^5.2.2",
    "luxon": "^3.5.0",
    "nuxt": "^4.5.2",
    "vue": "latest"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.13.0",
    "oxfmt": "^0.66.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true
  }
}
